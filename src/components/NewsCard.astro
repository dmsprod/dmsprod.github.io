---
import { getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { type NewsEntry, newsUrl, formatDate, tagUrl, tagLabel } from '../lib/news';

interface Props { entry: NewsEntry; delay?: number }
const { entry, delay = 0 } = Astro.props;
const { title, date, summary, cover, coverAlt, tags, groups, draft } = entry.data;
const groupEntries = await getEntries(groups);
---

<article class="card reveal" style={`--delay:${delay}ms`}>
  <div class:list={['card__media', { 'card__media--empty': !cover }]}>
    {cover
      ? <img src={cover} alt={coverAlt ?? ''} loading="lazy" width="1200" height="675" />
      : <Image src={logo} alt="" height={240} style="width:auto; height:62%; object-fit:contain; opacity:.85" loading="lazy" />}
  </div>
  <div class="card__body">
    <div class="card__meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      {groupEntries.map((g) => <span class="badge">{g.data.name}</span>)}
      {draft && <span class="badge" style="background:var(--accent)">Brouillon</span>}
    </div>
    <h3 class="card__title"><a class="card__link" href={newsUrl(entry)}>{title}</a></h3>
    <p class="card__text">{summary}</p>
    {tags.length > 0 && (
      <ul class="tags">{tags.map((tag) => <li><a class="tag" href={tagUrl(tag)}>{tagLabel(tag)}</a></li>)}</ul>
    )}
  </div>
</article>
