---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable">
  <section class="hero hero--plain">
    <div class="container">
      <span class="eyebrow">Erreur 404</span>
      <h1 class="hero__title gold-text">Larsen.</h1>
      <p class="hero__lead">Cette page n'existe pas, ou plus. Le reste du site, lui, est toujours bien accordé.</p>
      <div class="btn-row">
        <a class="btn" href="/">Retour à l'accueil <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/actualites/">Actualités</a>
      </div>
    </div>
  </section>
</Base>
